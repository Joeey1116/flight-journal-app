{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "package": "com.beatrackfaminc.flightjournal",
      "versionCode": 1007
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "icon": "./assets/icon.png",
    "ios": {
      "buildNumber": "1007",
      "bundleIdentifier": "com.beatrackfaminc.flightjournal",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Flight Journal sends you currency and deadline reminders you asked for.",
        "UIDesignRequiresCompatibility": false
      },
      "supportsTablet": true
    },
    "name": "Flight Journal",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#000000",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 24,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.3.20"
          },
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "dynamic"
          }
        }
      ],
      "./plugins/with-kotlin-gradle-plugin-version",
      "./plugins/with-privacy-manifest",
      "./plugins/with-app-clip",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": false,
          "tvosDeploymentTarget": "16.4",
          "appleTVImages": {
            "icon": "./assets/tv/tvos-icon-1280x768.png",
            "iconSmall": "./assets/tv/tvos-icon-small-400x240.png",
            "iconSmall2x": "./assets/tv/tvos-icon-small2x-800x480.png",
            "topShelf": "./assets/tv/tvos-topshelf-1920x720.png",
            "topShelf2x": "./assets/tv/tvos-topshelf2x-3840x1440.png",
            "topShelfWide": "./assets/tv/tvos-topshelf-wide-2320x720.png",
            "topShelfWide2x": "./assets/tv/tvos-topshelf-wide2x-4640x1440.png"
          }
        }
      ],
      "./plugins/with-tvos-signing",
      "expo-asset"
    ],
    "scheme": "flightjournal",
    "slug": "flight-journal-app",
    "userInterfaceStyle": "dark",
    "version": "1.0.0",
    "web": {
      "backgroundColor": "#05070D",
      "bundler": "metro",
      "description": "Flight Journal — a pilot logbook for airline and sim pilots: log flights, track currency, and export a print-ready logbook. No account, data stays on your device.",
      "display": "standalone",
      "favicon": "./assets/favicon.png",
      "lang": "en",
      "name": "Flight Journal",
      "orientation": "portrait",
      "output": "static",
      "scope": "/",
      "shortName": "Flight Journal",
      "startUrl": "/",
      "themeColor": "#05070D"
    }
  }
}