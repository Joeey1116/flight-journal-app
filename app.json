{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "package": "com.beatrackfaminc.flightjournal",
      "versionCode": 1003,
      "googleServicesFile": "./google-services.json"
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "icon": "./assets/icon.png",
    "ios": {
      "buildNumber": "1003",
      "bundleIdentifier": "com.beatrackfaminc.flightjournal",
      "googleServicesFile": "./GoogleService-Info.plist",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "Flight Journal sends you currency and deadline reminders you asked for.",
        "UIDesignRequiresCompatibility": false
      },
      "supportsTablet": true
    },
    "name": "Flight Journal",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#000000",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 24,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.3.20"
          },
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "dynamic"
          }
        }
      ],
      "./plugins/with-kotlin-gradle-plugin-version",
      "./plugins/with-firebase-auth-version",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier is used to personalize your Flight Journal experience. We run no ads and no third-party trackers \u2014 it stays off unless you turn it on."
        }
      ],
      "./plugins/with-privacy-manifest",
      "./plugins/with-app-clip",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-asset"
    ],
    "scheme": "flightjournal",
    "slug": "flight-journal-app",
    "userInterfaceStyle": "dark",
    "version": "1.0.0",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}